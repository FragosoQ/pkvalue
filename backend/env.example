# Copia para .env e preenche. As chaves nunca vão para o git.
POKETRACE_API_KEY=
POKETRACE_PLAN=free          # free | pro | growth | scale  (free = só mercado US, sem graduadas)
PPT_API_KEY=
PPT_PLAN=free                # free | api | business       (free = sem selado, sem JP, 3 dias histórico)
DB_PATH=pokevalor.db
OUTPUT_JSON=../dados.json    # ficheiro lido pela app HTML
DAILY_BUDGET_POKETRACE=240   # margem abaixo do limite do plano
DAILY_BUDGET_PPT=90
SHEETS_URL=                  # Web app do Apps Script (opcional; substitui itens.json)
SHEETS_TOKEN=
